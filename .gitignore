# Dependencies and build targets
node_modules/
cortex-speech-app/node_modules/
dist/
cortex-speech-app/dist/
target/
cortex-speech-app/target/
cortex-speech-app/src-tauri/target/

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment & credentials
.env
.env.local
.env.*

# Logs, coverage, and reports
*.log
logs/
reports/
playwright-report/
test-results/
coverage/

# Temporary and backup files
*.tmp
*.temp
*.tar
*.tar.gz
*.tar.bz2
*.zip
*.7z

# Audio model weights & media
*.onnx
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.aac
*.opus
*.mp4
*.mov
*.webm
*.wma
cortex-speech-app/src-tauri/models/*
!cortex-speech-app/src-tauri/models/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Tauri icons
cortex-speech-app/src-tauri/icons/*.png
cortex-speech-app/src-tauri/icons/*.ico
!cortex-speech-app/src-tauri/icons/icon.png
!cortex-speech-app/src-tauri/icons/icon.ico

# Binaries and local execution logs
*.exe
sherpa-onnx-v1.13.2-win-x64-shared-MD-Release/
cortex-speech-app/src-tauri/sherpa-onnx-v1.13.2-win-x64-shared-MD-Release/
*.txt
!docs/*.txt
screenshot_now.png
db_rs_original.rs
Kurdish_ASR_Model_Export/

# Python bytecode cache (generated by running the root dev/eval scripts)
__pycache__/
*.pyc

# Private per-owner datasets (embed local audio paths + private transcripts). Regenerated locally
# by the dataset scripts; must never enter the public repo (F3 privacy fix, 2026-07-02).
*_perfect_dataset.json
podcast_transcription.txt

# Claude Code local state (machine-local; never commit). settings.local.json holds per-machine
# tool permissions; .claude/worktrees/ is scratch checkouts. Shared .claude config (settings.json,
# skills) is intentionally NOT ignored — mirrors cortex-speech-app/.gitignore's convention.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/skills/**/*.md.txt

# Local debug/rating scratch — contains machine-local profile paths; never publish.
DEBUG_cortex.md

# Fetched at build time by scripts/fetch_models.py (pinned MS onnxruntime release) into
# models/onnxruntime.dll/ and bundled from there — these src-tauri-root copies are redundant.
cortex-speech-app/src-tauri/onnxruntime.dll
cortex-speech-app/src-tauri/onnxruntime_providers_shared.dll

# The owner's private external audit dropped at the repo root — intentionally NOT tracked (docs refer to
# it as a local reference). Ignored so it can't be committed by accident and doesn't clutter git status.
/1010PATH.md
.month-loop.lock
.loop-to-10.lock

# cargo-mutants run output (reports are CI artifacts, never committed)
mutants.out/
mutants-out/
mutants.out.old/

# cargo-llvm-cov output
lcov.info
coverage/

# cargo-fuzz working data: the corpus accumulates thousands of tiny inputs (CI caches it
# between nights) and artifacts/ holds crash reproducers for triage. Neither is source.
cortex-speech-app/src-tauri/fuzz/corpus/
cortex-speech-app/src-tauri/fuzz/artifacts/

# Product/UX audit working directories: the screenshots are of the owner's LIVE library, so they
# carry real transcripts, speaker material and local paths, and REPORT.md embeds absolute
# user-profile paths that scripts/test_windows_repo_hygiene.py rejects in tracked files. Owner
# confirmed these are his own 2026-08-03 audit artifacts and are not to be published.
docs/audits/
# Same class, same reasons (2026-08-05): a top-level audit folder of live-library screenshots plus
# DEEP_BRUTAL_AUDIT_CURRENT.md, which embeds absolute C:\Users\... paths the hygiene gate rejects in
# tracked files. Caught only because a `git add -A` swept it into a commit that had to be undone —
# ignoring it means the next careless add cannot repeat that.
audit-2026-08-05/

# Downloaded FLEURS ckb_IQ eval corpus (scripts/build_fleurs_ckb_manifest.py, ~1-2 GB, one-time).
# The clips are covered by *.wav, but the GENERATED manifest is not: it carries the corpus references
# and absolute local paths, and the licence position recorded in the ledger is "eval-only corpus; no
# audio/refs committed". The portable, reference-only record that IS committed is
# cortex-speech-app/docs/eval/fleurs_ckb_iq_frozen.rel.tsv - a different file, with relative paths.
cortex-speech-app/scripts/fleurs_ckb_iq/

# Third-party corpora live on disk, never in git. CORDI alone is 3.94 GiB / 186,739 files, and it is
# CC BY-SA 4.0 from upstream — this repo evaluates against it and does not redistribute it.
# PROVENANCE.md beside the data IS tracked: the licence, hash and origin are the part that must survive.
datasets/**
# Directories must stay re-included or git never descends into them, and then the negations below
# can never match: "it is not possible to re-include a file if a parent directory is excluded".
!datasets/**/
!datasets/**/*.md

# Vendored pinned model (see cortex-speech-app/scripts/fetch_models.py) — the sole *.onnx exception.
!cortex-speech-app/vendor/silero_vad_v4.onnx

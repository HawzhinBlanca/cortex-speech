{
  "name": "cortex-speech-app",
  "private": true,
  "version": "2.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python-policies": "python scripts/run_python_policies.py",
    "test:e2e": "playwright test",
    "test:e2e:real": "node e2e_real_app.cjs",
    "test:heartbeat": "node scripts/heartbeat_probe.cjs",
    "test:jobs": "node scripts/jobs_probe.cjs",
    "test:egress": "node scripts/egress_probe.cjs",
    "test:latency": "node scripts/latency_probe.cjs",
    "fetch-models": "python scripts/fetch_models.py",
    "verify-models": "python scripts/fetch_models.py --check",
    "tauri:build:smoke": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml --bin cortex-speech-app",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml --test tauri_integration -- --nocapture",
    "test:soak": "cargo test --manifest-path src-tauri/Cargo.toml --test soak -- --nocapture",
    "test:real-audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-real-data.ps1",
    "test:real-audio:user": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-real-data.ps1 -SkipUnitTests -UserPodcastTest",
    "test:real-audio:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-real-data.ps1 -Integration",
    "test:real-audio:integration:mp4": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-real-data.ps1 -Integration -Mp4Only",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "svelte-check && tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/svelte": "^5.2.1",
    "@tsconfig/svelte": "^5.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "playwright": "^1.48.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.56.3",
    "svelte-check": "^4.0.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
